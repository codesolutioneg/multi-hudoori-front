<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: launcher icon on brand blue. The Flutter
         splash (HudooriSplash) starts from this exact frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/hudoori_launch_blue</item>
        <item name="android:windowBackground">@color/hudoori_launch_blue</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
